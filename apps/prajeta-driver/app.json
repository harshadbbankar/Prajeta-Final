{
  "expo": {
    "name": "Prajeta Driver",
    "slug": "prajeta-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prajetadriver",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.prajeta.driver",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Show customers where you are during trips",
        "NSCameraUsageDescription": "Take your driver profile selfie",
        "NSPhotoLibraryUsageDescription": "Choose your driver profile photo"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#E53935"
      },
      "package": "com.prajeta.driver",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-font",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose your driver profile photo",
          "cameraPermission": "Take your driver profile selfie"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/ionicons",
      "expo-sharing",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Show customers where you are during trips"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}